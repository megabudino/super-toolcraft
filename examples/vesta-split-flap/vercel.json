{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build --base /demos/vesta-split-flap/",
  "rewrites": [
    {
      "source": "/demos/vesta-split-flap/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/demos/vesta-split-flap",
      "destination": "/"
    },
    {
      "source": "/demos/vesta-split-flap/:path*",
      "destination": "/"
    }
  ]
}
