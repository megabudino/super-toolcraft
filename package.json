{
  "name": "super-toolcraft",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "new-app": "node scripts/new-app.mjs",
    "build:apps": "node scripts/build-all.mjs --apps-only",
    "build": "node scripts/build-all.mjs",
    "dev": "pnpm --filter platform dev",
    "platform:init": "node scripts/platform-init.mjs",
    "db:migrate": "pnpm --filter platform db:migrate",
    "test": "node --test scripts/*.test.mjs && pnpm --filter platform test"
  },
  "toolcraft": {
    "cliVersion": "0.0.26"
  }
}
